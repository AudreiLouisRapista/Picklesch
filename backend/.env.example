# Picklesch backend — environment profiles
#
# NODE_ENV selects the active profile: development | staging | production
# (the test runner forces NODE_ENV=test itself).
# Each profile MUST use its own MongoDB cluster, API URL/port, and Sentry
# project — never share values across profiles.

# --- development ---
NODE_ENV=development
PORT=4000
API_BASE_URL=http://localhost:4000
MONGODB_URI=mongodb://localhost:27017/picklesch_dev
SENTRY_DSN=

# --- staging (separate cluster + monitoring project) ---
# NODE_ENV=staging
# PORT=4000
# API_BASE_URL=https://<staging-api-host>
# MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>/picklesch_staging
# SENTRY_DSN=https://<key>@o0.ingest.sentry.io/<staging-project>

# --- production (separate cluster + monitoring project) ---
# NODE_ENV=production
# PORT=4000
# API_BASE_URL=https://<prod-api-host>
# MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>/picklesch_prod
# SENTRY_DSN=https://<key>@o0.ingest.sentry.io/<prod-project>
